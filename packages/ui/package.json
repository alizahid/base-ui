{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": {
      "types": "./src/components/*",
      "default": "./dist/components/*"
    },
    "#lib/*": {
      "types": "./src/lib/*",
      "default": "./dist/lib/*"
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./date-field": {
      "types": "./src/components/date-field/index.ts",
      "default": "./dist/components/date-field/index.js"
    },
    "./phone-field": {
      "types": "./src/components/phone-field/index.ts",
      "default": "./dist/components/phone-field/index.js"
    },
    "./reset.css": "./src/reset.css",
    "./styles.css": "./dist/stylex.css",
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "build": "node ./esbuild.config.mjs",
    "dev": "node ./esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@radix-ui/colors": "^3.0.0",
    "@stylexjs/stylex": "^0.19.2",
    "cn": "^0.5.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@stylexjs/unplugin": "^0.19.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "date-fns": "^3.6.0",
    "esbuild": "^0.28.2",
    "libphonenumber-js": "^1.13.16",
    "typescript": "7.0.2",
    "use-lilius": "^2.0.5"
  },
  "peerDependencies": {
    "date-fns": "^3.6.0",
    "libphonenumber-js": "^1.13.16",
    "use-lilius": "^2.0.5"
  },
  "peerDependenciesMeta": {
    "date-fns": {
      "optional": true
    },
    "libphonenumber-js": {
      "optional": true
    },
    "use-lilius": {
      "optional": true
    }
  }
}
