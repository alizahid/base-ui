{
  "name": "basedkit",
  "version": "0.1.0",
  "description": "React components with the look of Radix Themes, built on Base UI",
  "homepage": "https://base-ui-wine.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alizahid/base-ui.git",
    "directory": "packages/ui"
  },
  "license": "MIT",
  "type": "module",
  "imports": {
    "#components/*": {
      "types": "./src/components/*",
      "default": "./dist/components/*"
    },
    "#lib/*": {
      "types": "./src/lib/*",
      "default": "./dist/lib/*"
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./date-field": {
      "types": "./src/components/date-field/index.ts",
      "default": "./dist/components/date-field/index.js"
    },
    "./phone-field": {
      "types": "./src/components/phone-field/index.ts",
      "default": "./dist/components/phone-field/index.js"
    },
    "./changelog.md": "./changelog.md",
    "./reset.css": "./src/reset.css",
    "./styles.css": "./dist/stylex.css",
    "./theme.css": "./src/theme.css"
  },
  "files": [
    "dist",
    "src",
    "changelog.md"
  ],
  "scripts": {
    "build": "node ./esbuild.config.mjs",
    "dev": "node ./esbuild.config.mjs --watch",
    "prepublishOnly": "rm -rf dist && bun run build && cp ../../readme.md ../../license .",
    "release": "GITHUB_TOKEN=$(gh auth token) release-it",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@radix-ui/colors": "^3.0.0",
    "@stylexjs/stylex": "^0.19.2",
    "cn": "^0.5.2"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.2",
    "@repo/typescript-config": "workspace:*",
    "@stylexjs/unplugin": "^0.19.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "^0.28.2",
    "libphonenumber-js": "^1.13.16",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "release-it": "^21.1.2",
    "typescript": "7.0.2",
    "use-lilius": "^2.0.5"
  },
  "peerDependencies": {
    "libphonenumber-js": "^1.9.46",
    "react": ">=19",
    "react-dom": ">=19",
    "use-lilius": "^2"
  },
  "peerDependenciesMeta": {
    "libphonenumber-js": {
      "optional": true
    },
    "use-lilius": {
      "optional": true
    }
  }
}
