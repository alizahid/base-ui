{
  "name": "base-ui-themes",
  "version": "0.0.0",
  "description": "A Radix Themes alternative built with Base UI and Tailwind CSS",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "!src/**/*.stories.tsx"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles/index.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "build-storybook": "storybook build",
    "dev": "storybook dev -p 6006",
    "format": "biome check --write .",
    "generate": "bun scripts/generate-styles.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/colors": "^3.0.0",
    "cn": "^0.5.2",
    "tailwind-variants": "^4.0.2"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@biomejs/biome": "^2.6.6",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  }
}
